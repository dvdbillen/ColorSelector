#ifndef cosel_qt_select_group_hsl2_h
#define cosel_qt_select_group_hsl2_h

#include "cosel_model_oklch.h"
#include "cosel_qt_select_group_base.h"

namespace cosel {

// TODO: If sat goes to zero, not applied to hue gradient

////////////////////////////////////////////////////////////////////////////////////////////////////
// oklch_selector

class oklch_selector : public color_selector {
    constexpr static double lum_range = 100;
    constexpr static double chr_range = 100;
    constexpr static double hue_range = 100;

    constexpr static double lum_irange = 1/lum_range;
    constexpr static double chr_irange = 1/chr_range;
    constexpr static double hue_irange = 1/hue_range;

    class lum_gradient_t : public linear_gradient_t<oklch> {
    public:
        explicit lum_gradient_t(const oklch& c_, size_t n) :
            linear_gradient_t<oklch>(c_, n, [](const oklch& c, double pos) {

            oklch oklch_c(pos, c.c(), c.h());
            return oklch_c.to_rgb();
        }) {}
    };

    class chr_gradient_t : public linear_gradient_t<oklch> {
    public:
        explicit chr_gradient_t(const oklch& c_, size_t n) :
            linear_gradient_t<oklch>(c_, n, [](const oklch& c, double pos) {

            oklch oklch_c(c.l(), pos, c.h());
            return oklch_c.to_rgb();
        }) {}
    };

    class hue_gradient_t : public linear_gradient_t<oklch> {
    public:
        explicit hue_gradient_t(const oklch& c_, size_t n) :
            linear_gradient_t<oklch>(c_, n, [](const oklch& c, double pos) {

            oklch oklch_c(c.l(), c.c(), pos);
            return oklch_c.to_rgb();
        }) {}
    };

    oklch oklch_color;

    gradient_slider* lum = nullptr;
    gradient_slider* chroma = nullptr;
    gradient_slider* hue = nullptr;

    std::shared_ptr<lum_gradient_t> lum_gradient;
    std::shared_ptr<chr_gradient_t> chroma_gradient;
    std::shared_ptr<hue_gradient_t> hue_gradient;

    void initialize();
    void handle_color_change() override;
    void handle_slider_change(int which_slider);
    void rethink_gradients(int unchanged_slider);
public:
    explicit oklch_selector(selector_type_t type, const color_selector_color_t& color,
                           const gradient_slider::style_options_t& options_) :
        color_selector(type, color, options_) {
        initialize();
    }
};

inline void oklch_selector::initialize() {
    oklch_color = oklch(selection_->rgb());

    auto* lgrad = new lum_gradient_t(oklch_color, 50);
    lum_gradient = std::shared_ptr<lum_gradient_t>(lgrad);
    auto* sgrad = new chr_gradient_t(oklch_color, 50);
    chroma_gradient = std::shared_ptr<chr_gradient_t>(sgrad);
    auto* hgrad = new hue_gradient_t(oklch_color, 50);
    hue_gradient = std::shared_ptr<hue_gradient_t>(hgrad);

    const auto& info = model_info_t::info(selector_type_t::hsloklab);
    const auto& names = info.component_names();

    lum = new gradient_slider(names[0], 0, lum_range, options, oklch_color.l());
    lum->set_gradient(lum_gradient);

    chroma = new gradient_slider(names[1], 0, chr_range, options, oklch_color.c());
    chroma->set_gradient(chroma_gradient);

    hue = new gradient_slider(names[2], 0, hue_range, options, oklch_color.h());
    hue->set_gradient(hue_gradient);

    connect(lum, &gradient_slider::changed, this, [this]() {
        handle_slider_change(0);
    });
    connect(chroma, &gradient_slider::changed, this, [this]() {
        handle_slider_change(1);
    });
    connect(hue, &gradient_slider::changed, this, [this]() {
        handle_slider_change(2);
    });

    auto* layout = make_slider_layout({lum, chroma, hue});
    setLayout(layout);

    oklch_selector::handle_color_change();
}

inline void oklch_selector::handle_color_change() {
    oklch_color = oklch(selection_->rgb());

    lum->set_value(oklch_color.l()*lum_range);
    chroma->set_value(std::min(oklch_color.c()*chr_range, chr_range));
    hue->set_value(oklch_color.h()*hue_range);

    rethink_gradients(-1);
}

inline void oklch_selector::handle_slider_change(int which_slider) {
    const auto l = lum->value()*lum_irange;
    const auto c = chroma->value()*chr_irange;
    const auto h = hue->value()*hue_irange;
    oklch oklch_c(l, c, h);
    selection_->set_rgb(oklch_c.to_rgb(), color_id);

    rethink_gradients(which_slider);
}

inline void oklch_selector::rethink_gradients(int unchanged_slider) {

    const auto c = oklch(selection_->rgb());

    assert(std::isfinite(c.l()));
    assert(std::isfinite(c.c()));
    assert(std::isfinite(c.h()));

    if(unchanged_slider != 0) {
        lum_gradient->set(c, lum->gradient()->size());
        lum->set_gradient(lum_gradient);
    }

    if(unchanged_slider != 1) {
        chroma_gradient->set(c, chroma->gradient()->size());
        chroma->set_gradient(chroma_gradient);
    }

    if(unchanged_slider != 2) {
        hue_gradient->set(c, hue->gradient()->size());
        hue->set_gradient(hue_gradient);
    }
}


} // namespace cosel


#endif // cosel_qt_select_group_hsl2_h
